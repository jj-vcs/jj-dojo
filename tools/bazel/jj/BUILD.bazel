load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load(
    "//tools/bazel/jj:versions.bzl",
    "DEFAULT_JJ_VERSION",
    "JJ_PLATFORMS",
    "JJ_VERSIONS",
    "jj_version_slug",
)

package(default_visibility = ["//visibility:public"])

exports_files([
    "extensions.bzl",
    "versions.bzl",
])

_UNIX_TARGET_COMPATIBLE_WITH = select(dict(
    [
        (
            "@jj_binaries//:" + platform,
            [],
        )
        for platform, meta in JJ_PLATFORMS.items()
        if meta["os"] != "@platforms//os:windows"
    ] + [
        (
            "//conditions:default",
            ["@platforms//:incompatible"],
        ),
    ],
))

_WINDOWS_TARGET_COMPATIBLE_WITH = select(dict(
    [
        (
            "@jj_binaries//:" + platform,
            [],
        )
        for platform, meta in JJ_PLATFORMS.items()
        if meta["os"] == "@platforms//os:windows"
    ] + [
        (
            "//conditions:default",
            ["@platforms//:incompatible"],
        ),
    ],
))

[
    copy_file(
        name = "_copy_jj_unix_" + jj_version_slug(version),
        src = "@jj_binaries//:jj_" + jj_version_slug(version),
        out = version + "/jj",
        is_executable = True,
        target_compatible_with = _UNIX_TARGET_COMPATIBLE_WITH,
        visibility = ["//visibility:private"],
    )
    for version in JJ_VERSIONS.keys()
]

[
    copy_file(
        name = "_copy_jj_windows_" + jj_version_slug(version),
        src = "@jj_binaries//:jj_" + jj_version_slug(version),
        out = version + "/jj.exe",
        is_executable = True,
        target_compatible_with = _WINDOWS_TARGET_COMPATIBLE_WITH,
        visibility = ["//visibility:private"],
    )
    for version in JJ_VERSIONS.keys()
]

[
    alias(
        name = "copy_jj_" + jj_version_slug(version),
        actual = select({
            "@platforms//os:windows": ":_copy_jj_windows_" + jj_version_slug(version),
            "//conditions:default": ":_copy_jj_unix_" + jj_version_slug(version),
        }),
    )
    for version in JJ_VERSIONS.keys()
]

alias(
    name = "copy_jj",
    actual = ":copy_jj_" + jj_version_slug(DEFAULT_JJ_VERSION),
)
