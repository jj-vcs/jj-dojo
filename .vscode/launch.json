{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/bazel-bin",
        "--disable-extension",
        "vscode.git",
        "--disable-extension",
        "jj-view.jj-view"
      ],
      "outFiles": ["${workspaceFolder}/bazel-bin/**/*.js"],
      "preLaunchTask": "Compile extension"
    }
  ]
}
