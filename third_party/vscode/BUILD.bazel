load("//tools/bazel/jasmine:defs.bzl", "jasmine_test")
load("//tools/bazel/typescript:defs.bzl", "ts_library")

ts_library(
    name = "vscode_enums",
    srcs = ["vscode_enums.ts"],
    visibility = [
        "//src/testing:__pkg__",
    ],
)

ts_library(
    name = "rpc_protocol",
    srcs = glob(["rpc_protocol/**/*.ts"]),
    visibility = ["//visibility:public"],
)

jasmine_test(
    name = "tests",
    srcs = glob(["**/*_test.ts"]),
    deps = [
        ":rpc_protocol",
    ],
)
