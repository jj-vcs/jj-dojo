load("//tools/bazel/jasmine:defs.bzl", "jasmine_test")
load("//tools/bazel/typescript:defs.bzl", "ts_library")

package(default_visibility = ["//visibility:public"])

ts_library(
    name = "logging",
    srcs = glob(
        ["*.ts"],
        exclude = ["*_test.ts"],
    ),
    deps = [
        "//src/error",
        "//:node_modules/@types/vscode",
    ],
)

jasmine_test(
    name = "tests",
    srcs = glob(["*_test.ts"]),
    deps = [
        ":logging",
        "//src/error",
        "//src/testing",
        "//:node_modules/@types/vscode",
    ],
)
