load("//tools/bazel/jasmine:defs.bzl", "jasmine_test")
load("//tools/bazel/typescript:defs.bzl", "ts_library")

package(default_visibility = ["//visibility:public"])

ts_library(
    name = "optimistic_state_estimator",
    srcs = ["optimistic_state_estimator.ts"],
    deps = [
        "//src/api",
        "//src/file_system_watcher",
        "//src/logging",
        "//src/utils",
        "//src/utils:merge",
    ],
)

ts_library(
    name = "workspace_state_manager",
    srcs = ["workspace_state_manager.ts"],
    deps = [
        "//src/api",
        "//src/client",
        "//src/utils",
    ],
)

ts_library(
    name = "api_state_manager",
    srcs = ["api_state_manager.ts"],
    deps = [
        ":optimistic_state_estimator",
        ":workspace_state_manager",
        "//src/api",
        "//src/client",
        "//src/error",
        "//src/file_system_watcher",
        "//src/logging",
        "//src/network_reconnect_watcher",
        "//src/op_head_watcher",
        "//src/utils",
        "//:node_modules/@types/vscode",
    ],
)

# Keep unit tests free of real jj CLI and @parcel/watcher dependencies; place
# real jj CLI integration tests in *_integration_test.ts files below.
jasmine_test(
    name = "unit_tests",
    srcs = glob(
        ["*_test.ts"],
        exclude = ["*_integration_test.ts"],
    ),
    deps = [
        ":api_state_manager",
        ":optimistic_state_estimator",
        ":workspace_state_manager",
        "//src/api",
        "//src/client",
        "//src/error",
        "//src/file_system_watcher",
        "//src/logging",
        "//src/network_reconnect_watcher",
        "//src/op_head_watcher",
        "//src/testing",
        "//src/utils:merge",
        "//:node_modules/@types/vscode",
    ],
)

# Default size = "small" grants a 60s Bazel timeout (exceeding the 30s Jasmine
# spec timeout) without triggering Bazel's MODERATE (<2s) duration warning.
jasmine_test(
    name = "integration_tests",
    srcs = glob(["*_integration_test.ts"]),
    use_jj = True,
    deps = [
        ":api_state_manager",
        ":optimistic_state_estimator",
        "//src/api",
        "//src/client:subprocess_client",
        "//src/file_system_watcher",
        "//src/file_system_watcher:local_file_system_watcher",
        "//src/logging",
        "//src/testing",
        "//src/utils:merge",
        "//:node_modules/@types/node",
        "//:node_modules/@types/vscode",
    ],
)

test_suite(
    name = "tests",
    tests = [
        ":integration_tests",
        ":unit_tests",
    ],
)
