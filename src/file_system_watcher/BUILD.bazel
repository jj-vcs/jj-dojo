load("//tools/bazel/jasmine:defs.bzl", "jasmine_test")
load("//tools/bazel/typescript:defs.bzl", "ts_library")

package(default_visibility = ["//visibility:public"])

ts_library(
    name = "file_system_watcher",
    srcs = ["file_system_watcher.ts"],
    deps = [
        "//:node_modules/@types/vscode",
    ],
)

ts_library(
    name = "local_file_system_watcher",
    srcs = ["local_file_system_watcher.ts"],
    deps = [
        ":file_system_watcher",
        "//src/error",
        "//src/logging",
        "//:node_modules/@parcel/watcher",
        "//:node_modules/@types/node",
        "//:node_modules/@types/vscode",
    ],
)

jasmine_test(
    name = "tests",
    srcs = glob(
        ["**/*_test.ts"],
    ),
    deps = [
        ":file_system_watcher",
        ":local_file_system_watcher",
        "//src/logging",
        "//src/testing",
        "//:node_modules/@parcel/watcher",
        "//:node_modules/@types/node",
        "//:node_modules/@types/vscode",
        "//:node_modules/vscode-uri",
    ],
)
